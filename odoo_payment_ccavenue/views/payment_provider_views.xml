<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="payment_provider_form_ccavenue" model="ir.ui.view">
        <field name="name">payment.provider.form.ccavenue</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group string="CCAvenue Credentials" invisible="code != 'ccavenue'">
                    <field name="ccavenue_merchant_id" required="code == 'ccavenue' and state != 'disabled'"/>
                    <field name="ccavenue_access_code" required="code == 'ccavenue' and state != 'disabled'" password="True"/>
                    <field name="ccavenue_working_key" required="code == 'ccavenue' and state != 'disabled'" password="True"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
