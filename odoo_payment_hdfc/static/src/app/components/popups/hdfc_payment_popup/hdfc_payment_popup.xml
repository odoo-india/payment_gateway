<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="odoo_payment_hdfc.HDFCPaymentPopop">
        <Dialog
            size="'md'"
            footer="false"
            fullscreen="true"
            bodyClass="'w-100 h-100 d-flex flex-column justify-content-center align-items-center p-4 pb-5'">
            <t t-set-slot="header">
                <div class="position-relative w-100">

                    <!-- Header content -->
                    <div class="d-flex align-items-center justify-content-between">

                        <div class="d-flex align-items-center gap-3">
                            <h4 class="m-0">
                                UPI Payment
                            </h4>
                        </div>

                        <div t-on-click="confirmClosePopup" type="button" class="btn-close" aria-label="Close"/>
                    </div>

                </div>
                <div t-if="props.txnEnv == 'test'" class="hdfc-payment-ribbon hdfc-payment-ribbon-top-right">
                    <span class="text-bg-warning">TEST MODE</span>
                </div>
            </t>


            <!-- Body -->
            <div class="text-center">
                <div class="mb-4">
                    <div class="fs-3 fw-bold">
                        Amount
                        <span class="px-2 text-dark" t-esc="props.formattedAmount"/>
                    </div>
                </div>
                <div class="rounded shadow-sm bg-white"
                    style="display:inline-block; border: 2px solid #188FA2; background: #D9EFF3 !important; padding: 50px; padding-top: 40px; padding-bottom: 20px;">
                    <img class="w-100" style="max-width:225px; border-radius: inherit"
                    t-att-src="props.qrCode"
                    alt="HDFC QR Code"/>
                    <p class="fs-5 mb-0 pt-1" style="color: #333;">
                        Scan me in any UPI app
                    </p>
            </div>
            </div>

        </Dialog>
    </t>
</templates>
