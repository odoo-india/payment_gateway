<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">HDFC Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position='inside'>
                <group invisible="code != 'hdfc'" name="hdfc_credentials">
                    <field name="hdfc_merchant_id" string="Merchant ID" required="code == 'hdfc' and state != 'disabled'" />
                    <field name="hdfc_merchant_name" string="Name" required="code == 'hdfc' and state != 'disabled'" />
                    <field name="hdfc_merchant_key" string="Key" required="code == 'hdfc' and state != 'disabled'" password="1"/>
                    <field name="hdfc_merchant_vpa" string="VPA" required="code == 'hdfc' and state != 'disabled'" />
                </group>
            </group>

            <group name="availability" position='inside' >
                <field name="show_qr_on_invoice" invisible="code != 'hdfc'" required="code == 'hdfc' and state != 'disabled'" />
            </group>
        </field>
    </record>

</odoo>
