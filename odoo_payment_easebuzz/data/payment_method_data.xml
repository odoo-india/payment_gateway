<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_method_card" model="payment.method">
        <field name="name">Card</field>
        <field name="code">card</field>
        <field name="sequence">10</field>
        <field name="provider_id" ref="odoo_payment_easebuzz.payment_provider_easebuzz" />
        <field name="image" type="bytes" file="payment/static/img/card.png" />
        <field name="support_refund">partial</field>
    </record>

     <record id="payment_method_netbanking" model="payment.method">
        <field name="name">Netbanking</field>
        <field name="code">netbanking</field>
        <field name="provider_id" ref="odoo_payment_easebuzz.payment_provider_easebuzz"/>
        <field name="image" type="bytes" file="payment/static/img/bank.png"/>
        <field name="support_refund">partial</field>
        <field name="supported_country_ids" eval="[Command.set([ref('base.in')])]"/>
        <field name="supported_currency_ids" eval="[Command.set([ref('base.INR')])]"/>
    </record>

