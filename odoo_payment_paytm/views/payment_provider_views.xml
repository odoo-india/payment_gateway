<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="payment_provider_form_paytm" model="ir.ui.view">
        <field name="name">payment.provider.form.paytm</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group string="Paytm Credentials" invisible="code != 'paytm'">
                    <field name="paytm_merchant_id" required="code == 'paytm' and state != 'disabled'" password="True"/>
                    <field name="paytm_merchant_key" required="code == 'paytm' and state != 'disabled'" password="True"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
