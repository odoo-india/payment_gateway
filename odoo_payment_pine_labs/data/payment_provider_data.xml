<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="payment_provider_pine_labs" model="payment.provider">
        <field name="code">pine_labs</field>
        <field name="name">PineLabs</field>
        <field name="image_128" type="base64" file="odoo_payment_pine_labs/static/description/icon.png"/>
        <field name="module_id" ref="base.module_odoo_payment_pine_labs"/>
        <field name="payment_method_ids" eval="[Command.set([
            ref('payment.payment_method_card'),
            ref('payment.payment_method_emi_india'),
            ref('payment.payment_method_netbanking'),
            ref('payment.payment_method_upi'),
            ref('payment.payment_method_wallets_india')])]"
        />
    </record>
</odoo>
