<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">Pinelabs Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form" />
        <field name="arch" type="xml">
            <group name="provider_credentials" position='inside'>
                <group name="pine_labs_credentials"
                    invisible="code != 'pine_labs'">
                    <field name="pine_labs_client_id"
                        string="Client Id"
                        required="code == 'pine_labs' and state != 'disabled'" />
                    <field name="pine_labs_client_secret"
                        string="Client Secret"
                        required="code == 'pine_labs' and state != 'disabled'"
                        password="True" />
                </group>
            </group>
        </field>
    </record>
</odoo>
