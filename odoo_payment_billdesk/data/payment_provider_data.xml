<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_provider_billdesk" model="payment.provider">
        <field name="code">billdesk</field>
        <field name="name">BillDesk</field>
        <field name="image_128" type="base64" file="odoo_payment_billdesk/static/description/icon.png"/>
        <field name="module_id" ref="base.module_odoo_payment_billdesk" />
        <field name="payment_method_ids"
               eval="[Command.set([
                        ref('payment.payment_method_netbanking'),
                        ref('payment.payment_method_card'),
                        ref('payment.payment_method_wallets_india'),
                        ref('payment.payment_method_upi'),
                        ref('payment.payment_method_emi_india'),
                     ])]"
        />
    </record>

</odoo>
