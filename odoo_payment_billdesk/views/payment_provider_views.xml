<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">Billdesk Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form" />
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group name="billdesk_credentials"
                    invisible="code != 'billdesk'">
                    <field name="billdesk_merchant_id"
                        required="code == 'billdesk' and state != 'disabled'" />
                    <field name="billdesk_client_id"
                        required="code == 'billdesk' and state != 'disabled'" />
                    <field name="billdesk_key_id"
                        required="code == 'billdesk' and state != 'disabled'" />
                    <field name="billdesk_encryption_key"
                        required="code == 'billdesk' and state != 'disabled'"
                        password="True" />
                    <field name="billdesk_signing_key"
                        required="code == 'billdesk' and state != 'disabled'"
                        password="True" />
                </group>
            </group>
        </field>
    </record>

</odoo>
