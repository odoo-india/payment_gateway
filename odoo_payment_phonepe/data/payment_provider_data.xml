<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="payment_provider_phonepe" model="payment.provider">

        <field name="code">phonepe</field>
        <field name="name">PhonePe</field>
        <field name="image_128" type="base64" file="odoo_payment_phonepe/static/description/icon.png"/>
        <field name="module_id" ref="base.module_odoo_payment_phonepe" />
        <field name="payment_method_ids"
               eval="[Command.set([
                         ref('payment.payment_method_card'),
                         ref('payment.payment_method_netbanking'),
                         ref('payment.payment_method_upi')
                     ])]"
        />
    </record>

</odoo>
